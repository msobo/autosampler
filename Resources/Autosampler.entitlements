<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements des Hosts. Plugins (z. B. KORG Collection) lesen die Signatur und
  Entitlements des Host-Prozesses; ohne echte Signatur verweigern manche die
  Lizenzprüfung. Werte orientieren sich an etablierten Hosts (Ableton Live).
-->
<plist version="1.0">
<dict>
    <!-- Fremde, anders signierte Plugins laden -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Manche Plugins erzeugen Code zur Laufzeit (JIT, Kopierschutz) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Audio-Eingang für Hardware-Sampling -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Plugins, die Hilfs-Apps wie KORG Software Pass ansteuern -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
