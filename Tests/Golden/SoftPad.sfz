// Soft Pad, exported with Autosampler
// 5 samples

<control>
default_path=samples/

<global>
ampeg_attack=0.005
ampeg_release=0.25
amp_veltrack=50

<group>
<region> sample=Soft_Pad_048_C2_v064.wav lokey=0 hikey=54 lovel=1 hivel=64 pitch_keycenter=48 loop_mode=one_shot
<region> sample=Soft_Pad_048_C2_v127.wav lokey=0 hikey=54 lovel=65 hivel=127 pitch_keycenter=48 loop_mode=one_shot
<region> sample=Soft_Pad_060_C3_v064.wav lokey=55 hikey=127 lovel=1 hivel=64 pitch_keycenter=60 loop_mode=one_shot
<region> sample=Soft_Pad_060_C3_v127_rr1.wav lokey=55 hikey=127 lovel=65 hivel=127 pitch_keycenter=60 seq_length=2 seq_position=1 loop_mode=loop_continuous loop_start=1000 loop_end=2999
<region> sample=Soft_Pad_060_C3_v127_rr2.wav lokey=55 hikey=127 lovel=65 hivel=127 pitch_keycenter=60 seq_length=2 seq_position=2 loop_mode=one_shot
